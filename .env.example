# ==============================================================================
# IP FORGE Environment Configuration
# ==============================================================================

# Application Environment: 'development', 'staging', 'production'
FORGE_ENV=development
FORGE_LOG_LEVEL=INFO
FORGE_HOST=0.0.0.0
FORGE_PORT=8000

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# Active Provider: 'ollama', 'amd_vllm', 'openai'
# ------------------------------------------------------------------------------
LLM_PROVIDER=ollama

# Local Ollama (Apple M4 edge execution)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma:7b
OLLAMA_API_KEY=ollama

# AMD Developer Cloud vLLM (ROCm 6.x GPU instance)
AMD_VLLM_BASE_URL=http://localhost:8000/v1
AMD_VLLM_MODEL=meta-llama/Meta-Llama-3-70B-Instruct
AMD_VLLM_API_KEY=empty

# Cloud LLM Fallback (Optional)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# Storage & Vector Database
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=forge_codebase

# Redis (Session State & Event Streaming)
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (Persistence & Audit Trail)
DATABASE_URL=postgresql+asyncpg://forge:forge_password@localhost:5432/forge_db

# ------------------------------------------------------------------------------
# Sandbox & Target Repository
# ------------------------------------------------------------------------------
TARGET_REPO_PATH=./tests/dummy_repo
MAX_SELF_HEAL_ITERATIONS=3
MCP_EXECUTION_TIMEOUT_SECONDS=30
